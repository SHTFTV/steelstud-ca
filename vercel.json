{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/projects", "destination": "/projects/index.html" },
    { "source": "/projects/", "destination": "/projects/index.html" },
    { "source": "/((?!assets/|images/|projects/|projects$|.*\\.).*)", "destination": "/index.html" }
  ]
}
